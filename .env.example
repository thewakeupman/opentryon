VTON_APP_NAME=OpenTryOn
VTON_APP_TAGLINE=开源 AI 虚拟试衣
# Fill this after publishing; the UI will show a source-code link.
VTON_REPOSITORY_URL=
VTON_PROVIDER=fashn
# No-GPU opt-in public demo: set VTON_PROVIDER=space.
# Browser/API must explicitly consent before sending images to the public service.
VTON_WEIGHTS_DIR=./weights
VTON_DATA_DIR=./data
VTON_DEVICE=auto
# Protect all /api routes when exposing the server beyond localhost.
VTON_API_KEY=
# For VTON_PROVIDER=remote: another instance of this toolkit on a GPU server.
VTON_REMOTE_URL=
VTON_REMOTE_API_KEY=
VTON_RETENTION_HOURS=24
VTON_MAX_PENDING=8
